{
  "compilerOptions": {
    "target": "ES2023",
    // DOM is in the lib list because these scripts import modules from src/
    // that use web-platform globals (crypto.randomUUID, structuredClone).
    // The scripts themselves run on Node, which provides both.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["node"],

    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["scripts/**/*.ts", "src/lib/**/*.ts", "src/content/**/*.ts"]
}

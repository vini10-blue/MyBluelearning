# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and stays on your machine / Vercel only.
#
# ---- Browser (public) — exposed to the user, prefixed with VITE_ ----
# Microsoft Entra (Azure AD) app registration values.
#
# IMPORTANT: register a SEPARATE Entra app for MyBlueLearning rather than
# reusing the expenses app's registration. Sharing one would mean adding this
# app's origins to that app's redirect URIs, so a compromise of either app
# would reach the other's OneDrive scope.
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
# Where the app is hosted (used as redirect URI).
# Local dev: http://localhost:5173
# Production: https://<your-vercel-domain>
VITE_APP_URL=http://localhost:5173

# ---- Server (private) — only used by /api functions, NEVER prefixed VITE_ ----
# Anthropic API key for the ingest / grading functions.
ANTHROPIC_API_KEY=
# OPTIONAL — Entra tenant + app-registration ids used server-side to verify
# the caller's ID token. If unset, the functions fall back to the VITE_MSAL_*
# values above (tenant/client id are public, not secrets), so these only need
# setting to override that fallback.
MSAL_TENANT_ID=
MSAL_CLIENT_ID=
# OPTIONAL — comma-separated Entra object ids (oid) allowed to call the API.
# Unset = any user in the tenant may call it.
ALLOWED_USER_OIDS=
